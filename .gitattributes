*.sh text eol=lf
# README.md is generated by tools/docs/readme_tables.py; Python on Windows writes CRLF, which
# flipped the whole file between line endings (c195 -> #740). Stored as LF everywhere.
README.md text eol=lf
# Generated by tools/privacy/files_guide.py and checked byte for byte in CI (WP-09 9.12): the
# player's guide keeps its CRLF for Notepad, the game's copy of the rows stays LF.
docs/privacy/READ-ME-FIRST.txt -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
godot/data/files_register.json text eol=lf
# Each port PR appends a FIXLOG entry, so merges of main conflict on it. Union keeps both sides' lines.
# Honored by local git merges; GitHub's web merge ignores it.
docs/history/FIXLOG.md merge=union
